# ============================================================================
#  ShadowScribe 影书 — server configuration
#  Copy to .env and edit.  .env is gitignored; never commit real secrets.
# ============================================================================

# ---------------------------------------------------------------- security --
# Bearer token every /v1 route requires. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty ONLY for a local laptop run (an ephemeral token is printed at boot).
SS_TOKEN=

# Host port the API binds to. Expose this through your tunnel/reverse proxy.
SS_PORT=18080
SS_BIND=0.0.0.0
SS_MAX_UPLOAD_MB=2048
SS_CORS_ORIGINS=*

# ------------------------------------------------------------------ storage --
SS_DATA_DIR=/data
# false → delete audio as soon as it has been distilled (transcript is kept).
SS_KEEP_AUDIO=true
SS_AUDIO_RETENTION_DAYS=30

# ---------------------------------------------------------------------- ASR --
# tiny | base | small | medium | large-v3  (or a local path)
# small  = fast first run, ~480 MB
# medium = noticeably better Chinese, ~1.5 GB
# large-v3 = best quality, ~3 GB, still fine on a 40-core CPU box
SS_WHISPER_MODEL=small
SS_WHISPER_DEVICE=cpu
SS_WHISPER_COMPUTE_TYPE=int8
SS_WHISPER_LANGUAGE=zh
SS_WHISPER_BEAM_SIZE=5
SS_WHISPER_VAD_FILTER=true
# Prime the decoder with your own jargon / names. Example:
# SS_WHISPER_INITIAL_PROMPT=影书、因果记忆、MCP、Cursor、登录页
SS_WHISPER_INITIAL_PROMPT=
# Whisper 的 small 模型会混出繁体字。检索是子串匹配，混用会让同一条记忆裂成两条，
# 所以默认转成简体。未安装 opencc 时自动降级为不转换。
SS_SIMPLIFY_CHINESE=true
# Model hub mirror (mainland-friendly).
SS_HF_ENDPOINT=https://hf-mirror.com
# Mirrors do not proxy the Xet CAS endpoint, so keep classic HTTP downloads on.
# Turn off only if you download straight from huggingface.co.
SS_HF_DISABLE_XET=true
# 0 = use all cores
SS_ASR_CPU_THREADS=0

# ------------------------------------------------------------ diarization ----
# off       = no speaker attribution (works immediately, no extra model)
# embedding = voiceprint owner/guest labelling; needs a sherpa-onnx speaker model
SS_DIARIZATION=off
SS_SPEAKER_MODEL_DIR=
SS_OWNER_THRESHOLD=0.55

# ------------------------------------------------------------ distillation ---
SS_LLM_ENABLED=true
SS_LLM_BASE_URL=https://api.deepseek.com/v1
SS_LLM_API_KEY=
SS_LLM_MODEL=deepseek-chat
SS_LLM_TEMPERATURE=0.1
SS_LLM_TIMEOUT_S=240
# Transcript seconds per extraction call. 720 = 12 min.
SS_DISTILL_WINDOW_S=720
# Windows with less text than this are skipped (silence, door slams, etc).
SS_DISTILL_MIN_CHARS=40

# ------------------------------------------------------------------- memory --
# causal-memory = full causal graph (recommended, needs: pip install causal-memory)
# native        = built-in SQLite fallback, zero extra dependencies
SS_MEMORY_BACKEND=causal-memory
SS_MEMORY_DB=
# Let causal-memory run its own extraction on top of ours (doubles LLM cost).
SS_MEMORY_LLM_EXTRACTION=false

# --------------------------------------------------------------------- misc --
SS_TIMEZONE=Asia/Shanghai
SS_LOG_LEVEL=INFO
SS_WORKER_POLL_INTERVAL_S=2
SS_WORKER_MAX_ATTEMPTS=3

# --------------------------------------------------------- build-time only ---
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
INSTALL_MEMORY_BACKEND=true
INSTALL_SPEAKERS=false
# 0 = unlimited
SS_WORKER_CPUS=0
